CNTRL_API_URL=

# Local development: relative (or absolute) path from this project root to a local
# @gxpl/sdk checkout. When set, next dev compiles the sdk straight from its source
# and hot-reloads on every save — no publish/reinstall needed. Leave empty to use
# the installed package.
LOCAL_SDK_REL_PATH=

# Same for a local @cntrl-site/components checkout (run its `npm run build:watch`);
# resolves to that checkout's dist/.
LOCAL_COMPONENTS_REL_PATH=
